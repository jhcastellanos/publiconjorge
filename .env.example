# Servidor
PORT=3000
PUBLIC_URL=http://localhost:3000
NODE_ENV=development

# Obligatorio en producción. Genera uno largo y aleatorio.
SESSION_SECRET=reemplaza-este-secreto

# Stripe — nunca expongas STRIPE_SECRET_KEY ni STRIPE_WEBHOOK_SECRET en el frontend.
# Deja los Price IDs vacíos hasta crearlos en el Dashboard de Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TIRA=
STRIPE_PRICE_VIDEO=
STRIPE_PRICE_PRUEBA=

# PIN que el equipo de soporte entrega después de la llamada. Solo este valor abre Checkout.
CHECKOUT_SALES_PIN=0402

# Opcional: ID de configuración del Customer Portal de Stripe.
# STRIPE_PORTAL_CONFIGURATION_ID=


# En el Dashboard de Stripe, configura el Customer Portal para cancelar
# al final del período de facturación (at_period_end), no de inmediato.

# Solo desarrollo: incluye el enlace de acceso en la respuesta de la API
# si todavía no hay proveedor de email. Nunca actives esto en producción.
MEMBERSHIP_DEBUG_LINKS=false

# Proveedor de email: todavía no hay uno configurado.
# Los avisos se guardan en la tabla email_outbox para conectar un envío más adelante.
# EMAIL_PROVIDER=
