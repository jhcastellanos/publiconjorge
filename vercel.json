{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node -e \"console.log('Using public/ as static output')\"",
  "outputDirectory": "public",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/membership", "destination": "/membership.html" },
    { "source": "/api/:path*", "destination": "/api" }
  ]
}
